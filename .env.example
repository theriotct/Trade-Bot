DATABASE_PATH=database/trading.db
STARTING_CASH=100000
RISK_PERCENT=0.25
MAX_OPEN_POSITIONS=6
MAX_DAILY_LOSS=50
MAX_POSITION_VALUE=1000
SYMBOL_WHITELIST=AAPL,MSFT,SPY,QQQ,TSLA,NVDA

# Optional Alpaca integration. Paper-only execution is explicitly enforced by the app.
# Add your paper-account credentials, then switch these settings when ready.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
MARKET_DATA_PROVIDER=yfinance
ALPACA_DATA_FEED=iex
EXECUTION_MODE=local

# Separate, paper-only headline experiment. Starts off until credentials are configured.
NEWS_PROVIDER=alpaca
NEWS_ENABLED=false
NEWS_MIN_SENTIMENT=2
NEWS_HOLD_BARS=6
NEWS_MAX_AGE_MINUTES=30

# Monitor every symbol in SYMBOL_WHITELIST.
AUTO_SYMBOLS=*
AUTO_INTERVAL=5m
AUTO_PERIOD=60d
AUTO_POLL_SECONDS=60
AUTO_MODE=single
AUTO_STRATEGY=donchian
AUTO_STRATEGIES=trend,donchian,macd,bollinger,rsi,volatility_breakout,regression
AUTO_CONSENSUS_MIN=2
AUTO_MAX_QUANTITY=1
AUTO_ATR_STOP_MULTIPLE=2
AUTO_ATR_TAKE_PROFIT_MULTIPLE=2
