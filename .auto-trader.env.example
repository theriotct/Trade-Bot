# Copy into .env. Symbols must also appear in SYMBOL_WHITELIST.
AUTO_SYMBOLS=SPY
AUTO_INTERVAL=1d
AUTO_PERIOD=2y
AUTO_POLL_SECONDS=300

# single runs only AUTO_STRATEGY. consensus requires multiple techniques to agree.
AUTO_MODE=single
AUTO_STRATEGY=trend
AUTO_STRATEGIES=trend,donchian,macd,bollinger,rsi,volatility_breakout,regression
AUTO_CONSENSUS_MIN=2

# ATR-based risk sizing limits every order to this maximum quantity.
AUTO_MAX_QUANTITY=1
AUTO_ATR_STOP_MULTIPLE=2
