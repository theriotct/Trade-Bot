# Copy these lines into .env for PAPER day-trading practice.
# Keep symbols in SYMBOL_WHITELIST and use small quantities.
AUTO_SYMBOLS=SPY
AUTO_INTERVAL=5m
AUTO_PERIOD=60d
AUTO_POLL_SECONDS=60

# Start by testing one mode at a time.
AUTO_MODE=single
AUTO_STRATEGY=donchian
AUTO_MAX_QUANTITY=1
AUTO_ATR_STOP_MULTIPLE=2

# Existing risk settings: conservative defaults for paper practice.
MAX_POSITION_VALUE=1000
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS=50
RISK_PERCENT=0.25

